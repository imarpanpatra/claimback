# Copy to .env and fill in. .env is gitignored.
ANAKIN_API_KEY=

# Reasoning uses OpenAI when its key is set, with Gemini as the fallback.
# Either one on its own is enough.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The code judges enter to start a live run on the deployed site.
# Leave it empty to allow recorded replays only.
LIVE_RUN_CODE=
